{
  "name": "denvique-desktop-monitor",
  "version": "0.1.0",
  "description": "DENVique employee desktop companion for shift attendance and consented work monitoring.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg zip --arm64 --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:mac:intel": "electron-builder --mac dmg zip --x64 --publish never",
    "check": "node --check main.js && node --check renderer.js && node --check preload.js && node --check extension/service-worker.js && node -e \"JSON.parse(require('fs').readFileSync('extension/manifest.json','utf8'))\""
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.denvique.desktopmonitor",
    "productName": "DENVique Desktop Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html"
    ],
    "protocols": [
      {
        "name": "DENVique Desktop Monitor",
        "schemes": [
          "denvique-monitor"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "DENVique-Monitor-mac-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "DENVique Desktop Monitor reads the name of the frontmost application during an acknowledged work-monitoring session. It does not read window titles, typed text or application contents."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DENVique-Monitor-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "gaber11222",
        "repo": "denvique-website",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
